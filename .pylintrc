[FORMAT]
max-line-length=180

[MESSAGES CONTROL]
# Design-size checks on arguments, locals and similar lines are not enforced:
# the controller passes its state explicitly and comments heavily. Branch and
# statement counts per function *are* enforced (pylint defaults, 12 and 50):
# the decision used to live in one 480-line evaluate(), see MPCController.
# abstract-method misfires on Home Assistant base classes
# whose sync/async method pairs only need one side implemented.
disable=
    too-many-arguments,
    too-many-positional-arguments,
    too-many-locals,
    too-many-instance-attributes,
    too-many-public-methods,
    too-many-lines,
    duplicate-code,
    abstract-method
